# Copy to .env and fill in (Supabase dashboard -> Project Settings -> API).
# These two values are safe to ship in the app: access is enforced by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: browse every screen as owner / carer / admin with fake data and NO backend.
# Great for design review. Never enable in a production build.
EXPO_PUBLIC_PREVIEW_MODE=false

# Stripe publishable key (pk_test_... while testing). Safe to ship; the secret key lives only on the server.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
